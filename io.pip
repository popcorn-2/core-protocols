enum seek_ty(u8) {
	start@0,
	current@1,
	end@2
}

interface core.io.Write(00000000-00000000-0000-0002) {
	func@0 write(data: mem) -> nsize!err;
	func@1 put(byte: u8) -> !err;
}

interface core.io.Read(00000000-00000000-0000-0003) {
	func@0 read(len: nsize, data: outmem) -> !err;
	func@1 get() -> i16!;
}

interface core.io.Seek(00000000-00000000-0000-0004) {
	func@0 seek(ty: seek_ty, offset: isize) -> !err;
	func@1 tell() -> nsize!err;
}
